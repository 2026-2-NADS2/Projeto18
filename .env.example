# Copie para .env e preencha. O comando `npm run explain` lê este arquivo (--env-file).
# Sem a chave, o explicador cai no modo offline (determinístico, sem internet).

# Chave da API do Google Gemini (crie em https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo (opcional). Padrão: gemini-3.6-flash (free tier, rápido).
# GEMINI_MODEL=gemini-3.6-flash
